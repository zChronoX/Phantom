#!/system/bin/sh
# phantomctl · comandi della sonda F0 di Phantom (da eseguire come root).
#
#   phantomctl status | start | stop | restart
#   phantomctl scrcpy on [profilo] [h264|h265] | off | profiles | status
#   phantomctl stopsessions        ferma subito la sessione video scrcpy in corso
#   phantomctl postmortem [deep]   rapporto su un blocco o un riavvio anomalo; «deep» legge anche i dump del watchdog e i tombstone
#   phantomctl video on|off        flusso H.264 di base sulla porta 47802
#   phantomctl autostart on|off    avvio della sonda all'accensione
#   phantomctl doze on|off         forza il Doze profondo (per test rapidi) o lo ripristina
#   phantomctl wifi on|off|status  modalità Wi-Fi a bassa latenza e alte prestazioni di Android
#   phantomctl report              report completo del dispositivo
#   phantomctl log [righe]

MODDIR=${PHANTOM_MODDIR:-/data/adb/modules/phantom_f0}
DATA=${PHANTOM_DATA:-/data/adb/phantom-f0}
BIN=$MODDIR/bin/phantom-probe
SJ=$MODDIR/bin/scrcpy-server
PIDF=$DATA/probe.pid
LOG=$DATA/probe.log
CONF=$DATA/probe.conf

mkdir -p "$DATA"
[ -f "$CONF" ] || printf 'AUTOSTART=1\nVIDEO=0\nBITRATE=12000000\nSIZE=\nWIFI_LL=0\nSCRCPY=0\nSCRCPY_PROFILE=sw-low\nSCRCPY_CODEC=h264\nSCRCPY_OPTS=\n' > "$CONF"
. "$CONF"
: "${SCRCPY_PROFILE:=sw-low}"
: "${SCRCPY_CODEC:=h264}"

running() { [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; }

setconf() {
    grep -v "^$1=" "$CONF" > "$CONF.tmp"
    echo "$1=$2" >> "$CONF.tmp"
    mv "$CONF.tmp" "$CONF"
    . "$CONF"
}

# ---- profili scrcpy: una scala dal più leggero al più pesante, per trovare con precisione cosa fa bloccare il telefono.
# Il suffisso -rt (tempo reale) riattiva priorità e latenza «tempo reale» che scrcpy 4+ imposta di suo
# sull'encoder (novità della versione 4.0): sospettate di far impazzire l'encoder Qualcomm di questa ROM.
# Senza suffisso i parametri sono neutri, come nelle versioni precedenti.
#  1 sw-low      encoder software, nessun driver video del telefono        (verifica cattura + rete)
#  2 hw-low      encoder hardware, parametri neutri, carico basso          (aggiunge il driver video)
#  3 hw-low-rt   come 2 ma con i parametri «tempo reale»                   (isola i parametri aggressivi)
#  4 hw-mid      864×1920, 60 fps, 10 Mbps, neutro
#  5 hw-high     1080×2400, 60 fps, 16 Mbps, neutro
#  6 hw-max      1080×2400, 120 fps, 20 Mbps, neutro                       (il carico che si era bloccato)
#  7 hw-max-rt   come 6 ma «tempo reale»                                   (la configurazione esatta del blocco)
profile_load() {
    P_ENC=""; P_SIZE=""; P_FPS=60; P_BR=8000000; P_NEUTRAL=1
    name="$1"
    case "$name" in
        1) name=sw-low ;; 2) name=hw-low ;; 3) name=hw-low-rt ;; 4) name=hw-mid ;;
        5) name=hw-high ;; 6) name=hw-max ;; 7) name=hw-max-rt ;;
    esac
    base="${name%-rt}"
    [ "$base" != "$name" ] && P_NEUTRAL=0
    case "$base" in
        sw-low)
            [ "$P_NEUTRAL" = 0 ] && return 1  # l'encoder software non ha una variante «tempo reale»
            P_ENC=c2.android.avc.encoder; P_SIZE=1280; P_FPS=30; P_BR=4000000; P_DESC="software · 576×1280 · 30 fps · 4 Mbps" ;;
        hw-low)  P_SIZE=1280; P_FPS=30; P_BR=4000000; P_DESC="hardware · 576×1280 · 30 fps · 4 Mbps" ;;
        hw-mid)  P_SIZE=1920; P_FPS=60; P_BR=10000000; P_DESC="hardware · 864×1920 · 60 fps · 10 Mbps" ;;
        hw-high) P_FPS=60; P_BR=16000000; P_DESC="hardware · 1080×2400 · 60 fps · 16 Mbps" ;;
        hw-max)  P_FPS=120; P_BR=20000000; P_DESC="hardware · 1080×2400 · 120 fps · 20 Mbps" ;;
        *) return 1 ;;
    esac
    P_NAME=$name
    if [ "$P_NEUTRAL" = 1 ]; then P_DESC="$P_DESC · parametri neutri"; else P_DESC="$P_DESC · tempo reale"; fi
    return 0
}

# Opzioni per il server scrcpy, una per riga (nessuna contiene spazi).
profile_opts() {
    echo "video_codec=$SCRCPY_CODEC"
    echo "max_fps=$P_FPS"
    echo "video_bit_rate=$P_BR"
    [ -n "$P_SIZE" ] && echo "max_size=$P_SIZE"
    [ -n "$P_ENC" ] && echo "video_encoder=$P_ENC"
    if [ "$P_NEUTRAL" = 1 ]; then
        # Keyframe ogni 2 s (invece di 10) e senza priorità/latenza «tempo reale» che scrcpy imposta di suo.
        echo "video_codec_options=i-frame-interval=2,priority:int=1,latency:int=0"
    else
        echo "video_codec_options=i-frame-interval=2"
    fi
}

start() {
    if running; then echo "Sonda già attiva (PID $(cat "$PIDF"))"; return 0; fi
    # Il log non deve crescere all'infinito durante i test di più ore.
    [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 1048576 ] && mv "$LOG" "$LOG.1"
    set -- --daemon --pidfile "$PIDF" --log "$LOG" --state-dir "$DATA" --bitrate "$BITRATE"
    [ "$VIDEO" = 1 ] && set -- "$@" --video
    [ -n "$SIZE" ] && set -- "$@" --size "$SIZE"
    if [ "${SCRCPY:-0}" = 1 ]; then
        if [ -f "$SJ" ] && [ -f "$SJ.version" ] && profile_load "$SCRCPY_PROFILE"; then
            set -- "$@" --scrcpy-port 47803 --scrcpy-jar "$SJ" --scrcpy-version "$(cat "$SJ.version")" --scrcpy-profile "$P_NAME"
            for o in $(profile_opts); do set -- "$@" --scrcpy-opt "$o"; done
            # Opzioni extra scritte a mano in probe.conf (SCRCPY_OPTS="a=1 b=2"), applicate per ultime.
            set -f
            for o in ${SCRCPY_OPTS:-}; do set -- "$@" --scrcpy-opt "$o"; done
            set +f
        else
            echo "scrcpy è acceso ma manca il server in $SJ oppure il profilo «$SCRCPY_PROFILE» non è valido: non lo avvio"
        fi
    fi
    "$BIN" "$@"
    sleep 1
    if running; then echo "Sonda avviata"; else echo "Avvio fallito. Ultime righe del log:"; tail -n 5 "$LOG"; return 1; fi
}

stop() {
    if running; then
        pid=$(cat "$PIDF")
        kill "$pid" 2>/dev/null   # la sonda ferma da sola le sessioni scrcpy e il server
        i=0
        while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 30 ]; do sleep 0.1; i=$((i + 1)); done
        kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
    fi
    rm -f "$PIDF"
    echo "Sonda fermata"
}

wifi_ip() { ip -4 -o addr show wlan0 2>/dev/null | awk '{ split($4, a, "/"); print a[1]; exit }'; }

crash_warning() {
    if [ -f "$DATA/crash-last.txt" ]; then
        echo "⚠ L'ultima sessione scrcpy NON è finita in modo pulito: il telefono si è probabilmente bloccato."
        echo "  scrcpy è stato spento per sicurezza. Rapporto: $DATA/crash-last.txt"
        sed -n '/^profilo=/p;/^opzioni=/p' "$DATA/crash-last.txt" | head -n 2 | sed 's/^/  /'
    fi
}

status() {
    if running; then echo "Sonda: ATTIVA (PID $(cat "$PIDF"))"; else echo "Sonda: ferma"; fi
    echo "Video di base: $([ "$VIDEO" = 1 ] && echo acceso || echo spento) · avvio automatico: $([ "$AUTOSTART" = 1 ] && echo sì || echo no)"
    echo "Wi-Fi bassa latenza: $([ "${WIFI_LL:-0}" = 1 ] && echo attiva || echo spenta)"
    if [ -f "$SJ.version" ]; then
        if [ "${SCRCPY:-0}" = 1 ]; then
            profile_load "$SCRCPY_PROFILE" && echo "scrcpy: ACCESO · profilo $P_NAME ($P_DESC) · $SCRCPY_CODEC · porta 47803 · server v$(cat "$SJ.version")" \
                || echo "scrcpy: ACCESO ma profilo «$SCRCPY_PROFILE» non valido"
        else
            echo "scrcpy: spento · server v$(cat "$SJ.version")"
        fi
    else
        echo "scrcpy: server non incluso in questo pacchetto"
    fi
    crash_warning
    echo "Indirizzi del telefono:"
    ip -4 -o addr show 2>/dev/null | awk '$2 != "lo" { split($4, a, "/"); print "  " $2 ": " a[1] }'
    ipw=$(wifi_ip)
    if [ -n "$ipw" ]; then
        echo "Dall'iPhone (Safari):  http://$ipw:47801   (emergenza: http://$ipw:47801/stop)"
        echo "Dal PC:                python f0_client.py ping $ipw"
        [ "$VIDEO" = 1 ] && echo "Video dal PC:          python f0_client.py video $ipw"
        [ "${SCRCPY:-0}" = 1 ] && echo "Video scrcpy:          app iPhone → porta 47803"
    fi
    echo "Ultime righe del log:"
    tail -n 6 "$LOG" 2>/dev/null
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop >/dev/null; start ;;
    status | "") status ;;
    video)
        case "$2" in
            on) setconf VIDEO 1 ;;
            off) setconf VIDEO 0 ;;
            *) echo "uso: phantomctl video on|off"; exit 2 ;;
        esac
        stop >/dev/null; start
        echo "Video di base: $([ "$VIDEO" = 1 ] && echo acceso || echo spento)" ;;
    autostart)
        case "$2" in
            on) setconf AUTOSTART 1 ;;
            off) setconf AUTOSTART 0 ;;
            *) echo "uso: phantomctl autostart on|off"; exit 2 ;;
        esac
        echo "Avvio automatico: $([ "$AUTOSTART" = 1 ] && echo sì || echo no)" ;;
    doze)
        case "$2" in
            on)
                dumpsys battery unplug
                input keyevent 223
                sleep 2
                dumpsys deviceidle force-idle
                echo "Doze profondo forzato: schermo spento e caricatore simulato come scollegato." ;;
            off)
                dumpsys deviceidle unforce
                dumpsys battery reset
                input keyevent 224
                echo "Doze normale ripristinato." ;;
            *) echo "uso: phantomctl doze on|off"; exit 2 ;;
        esac ;;
    wifi)
        # Le uscite di `cmd` passano da una pipe: i servizi di sistema non possono scrivere su file in /data/adb.
        case "$2" in
            on)
                cmd wifi force-low-latency-mode enabled 2>&1 | cat
                cmd wifi force-hi-perf-mode enabled 2>&1 | cat
                setconf WIFI_LL 1
                echo "Wi-Fi bassa latenza ATTIVA: niente risparmio energetico sulla radio finché non la spegni o riavvii." ;;
            off)
                cmd wifi force-low-latency-mode disabled 2>&1 | cat
                cmd wifi force-hi-perf-mode disabled 2>&1 | cat
                setconf WIFI_LL 0
                echo "Wi-Fi bassa latenza spenta: comportamento normale." ;;
            status | "")
                echo "Wi-Fi bassa latenza (impostata da Phantom): $([ "${WIFI_LL:-0}" = 1 ] && echo attiva || echo spenta)"
                dumpsys wifi 2>/dev/null | grep -m 8 -iE "low.?latency|hi.?perf|power.?save" | cut -c1-160 ;;
            *) echo "uso: phantomctl wifi on|off|status"; exit 2 ;;
        esac ;;
    scrcpy)
        case "$2" in
            profiles)
                for n in 1 2 3 4 5 6 7; do
                    profile_load "$n"
                    echo "$n  $P_NAME$([ "$P_NAME" = "$SCRCPY_PROFILE" ] && [ "${SCRCPY:-0}" = 1 ] && echo '  ← attivo')"
                    echo "     $P_DESC"
                done
                echo "Si parte dall'1 e si sale di un gradino solo se il precedente ha funzionato bene per almeno un minuto."
                echo "Qualsiasi profilo hardware accetta anche il suffisso -rt (es. hw-mid-rt)." ;;
            on)
                if [ ! -f "$SJ" ]; then echo "Il server scrcpy non è incluso: usa il pacchetto compilato da GitHub Actions."; exit 1; fi
                prof="${3:-$SCRCPY_PROFILE}"
                if ! profile_load "$prof"; then echo "Profilo «$prof» sconosciuto: vedi phantomctl scrcpy profiles"; exit 2; fi
                case "$4" in
                    "") ;;
                    h264 | h265) setconf SCRCPY_CODEC "$4" ;;
                    *) echo "codec: h264 o h265"; exit 2 ;;
                esac
                if [ "$SCRCPY_CODEC" = h265 ] && [ "$P_ENC" = c2.android.avc.encoder ]; then
                    echo "Il profilo $P_NAME usa l'encoder software H.264: H.265 non è disponibile qui."; exit 2
                fi
                if [ -f "$DATA/crash-last.txt" ]; then
                    crash_warning
                    echo "  (avviso letto: lo cancello; i rapporti restano in $DATA)"
                    rm -f "$DATA/crash-last.txt"
                fi
                setconf SCRCPY_PROFILE "$P_NAME"
                setconf SCRCPY 1
                stop >/dev/null; start
                echo "scrcpy ACCESO · profilo $P_NAME ($P_DESC) · $SCRCPY_CODEC"
                echo "Se il POCO si blocca: chiudi l'app Phantom F0 sull'iPhone oppure apri http://$(wifi_ip):47801/stop in Safari." ;;
            off) setconf SCRCPY 0; stop >/dev/null; start; echo "scrcpy spento" ;;
            status | "") status | sed -n '/^scrcpy:/p'; crash_warning ;;
            *) echo "uso: phantomctl scrcpy on [profilo] [h264|h265] | off | profiles | status"; exit 2 ;;
        esac ;;
    stopsessions)
        ipw=$(wifi_ip)
        if running; then
            # La sonda risponde a /stop dalla rete locale; in mancanza di rete si ricorre al segnale.
            # Il file del blocco può contenere il pid di una sessione vecchia: si agisce solo se è davvero la sonda.
            if p=$(cat "$DATA/scrcpy.lock" 2>/dev/null) && [ -n "$p" ] && grep -q phantom-probe "/proc/$p/cmdline" 2>/dev/null; then
                kill "$p" && echo "Sessione scrcpy (pid $p) fermata"
            else
                echo "Nessuna sessione scrcpy attiva"
            fi
        else
            echo "La sonda è ferma"
        fi ;;
    postmortem)
        case "$2" in
            deep)
                # Legge i dump già salvati da Android (watchdog, tombstone): non avvia nessuna cattura, è sicuro.
                OUT=$DATA/deep.txt
                sh "$MODDIR/bin/phantom-deep.sh" > "$OUT" 2>&1
                if cp "$OUT" /sdcard/Download/phantom-f0-deep.txt 2>/dev/null; then
                    echo "Salvato in Download/phantom-f0-deep.txt ($(wc -c < "$OUT") byte): allegalo alla chat."
                else
                    echo "Salvato in $OUT ($(wc -c < "$OUT") byte); non sono riuscito a copiarlo in Download."
                fi
                echo
                sed -n '1,40p' "$OUT" ;;
            "")
                OUT=$DATA/postmortem.txt
                sh "$MODDIR/bin/phantom-postmortem.sh" > "$OUT" 2>&1
                cp "$OUT" /sdcard/Download/phantom-f0-postmortem.txt 2>/dev/null && echo "Salvato anche in Download/phantom-f0-postmortem.txt"
                cat "$OUT" ;;
            *) echo "uso: phantomctl postmortem [deep]"; exit 2 ;;
        esac ;;
    report) PHANTOM_MODDIR=$MODDIR sh "$MODDIR/bin/phantom-report.sh" ;;
    log) tail -n "${2:-50}" "$LOG" ;;
    *) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
